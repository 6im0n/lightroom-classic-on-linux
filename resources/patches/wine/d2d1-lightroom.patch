+        return;
+    }
+
+    if (!context->layers_count)
+        return;
+
+    entry = &context->layers[--context->layers_count];
+    if (entry->mask)
+    {
+        const struct d2d_geometry *mask_impl = unsafe_impl_from_ID2D1Geometry(entry->mask);
